# Copy to .env if you want to change anything. Nothing is required by default.

# Which Claude to use:
#   claude-code  your Claude subscription, via Claude Code logged in on this machine (default)
#   api          the Anthropic API, billed per token; needs ANTHROPIC_API_KEY
LLM_PROVIDER=claude-code
# ANTHROPIC_API_KEY=

# Server. Keep HOST at 127.0.0.1 when using Cloudflare Tunnel (it connects locally).
HOST=127.0.0.1
PORT=4400
DATA_DIR=data

# Models and effort per task (low | medium | high | xhigh | max). Defaults shown.
# MODEL=claude-opus-5-5          # default for every task
# MODEL_ARCHIVIST=
# MODEL_QA=
# EFFORT_ARCHIVIST=high
# EFFORT_QA=medium
# LLM_FALLBACKS=on               # API only: "off" to disable automatic fallback on refusals

# Embeddings for meaning-based search: local | none
# EMBEDDINGS=local

# Limits. The monthly cap applies to the API provider only.
# MONTHLY_SPEND_CAP_USD=50
# QA_MAX_TOOL_CALLS=12
# QA_PRESEARCH_TOKENS=3000       # search results sent with each question (0 = off)
# QA_MAX_COST_USD=0.5
# QA_RATE_PER_HOUR=30

# Archivist (processing). Generous by default: processing time doesn't matter.
# ARCHIVIST_MAX_TOOL_CALLS=250
# ARCHIVIST_MAX_COST_USD=25           # estimate; per run
# ARCHIVIST_INLINE_TRANSCRIPT_TOKENS=200000   # longer transcripts are read in parts

# Knowledge base
# KB_PINNED_TOKENS=6000               # pinned records are sent with every question
# KB_MAX_RECORD_TOKENS=4000

# Player notes written before this hour count towards the previous day's session.
# NOTES_ROLLOVER_HOUR=6
